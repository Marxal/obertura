# Copy this file to `.env` and fill in the real values. `.env` is gitignored —
# never commit it. Vite only exposes variables prefixed with VITE_ to the app.
#
# Both values come from the Supabase dashboard:
#   Project Settings → API (or Data API / API Keys on newer dashboards)
#
# The same two variables must also be set in the Cloudflare Pages project
# (Settings → Environment variables), because Vite inlines them at build time —
# the deployed build reads them from the build environment, not from this file.
#
# With neither set, the app still builds and boots; src/supabase.ts simply
# reports itself as not configured.

# Project URL, e.g. https://abcdefghijklmno.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The public "anon" / publishable key — safe to ship in the bundle, protected by
# row-level security. NOT the service_role key, which must never go in here.
VITE_SUPABASE_ANON_KEY=your-anon-key
