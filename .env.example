# Copy this file to `.env` and fill in the real values. `.env` is gitignored —
# never commit it. Vite only exposes variables prefixed with VITE_ to the app.
#
# Both values come from the Supabase dashboard:
#   Project Settings → API (or Data API / API Keys on newer dashboards)
#
# The site deploys as a Cloudflare Worker, not a connected Pages build — there
# is no dashboard build step that reads env vars on its own. Vite inlines these
# at build time, so the values that matter are whatever is in THIS file on the
# machine that runs `DEPLOY_TARGET=cloudflare npm run build && npx wrangler
# deploy` (see STRIPE-SETUP.md §4). An empty or missing .env at build time
# ships silently with defaults — nothing errors, it just won't have what you
# meant to include.
#
# With neither set, the app still builds and boots; src/supabase.ts simply
# reports itself as not configured.

# Project URL, e.g. https://abcdefghijklmno.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The public "anon" / publishable key — safe to ship in the bundle, protected by
# row-level security. NOT the service_role key, which must never go in here.
VITE_SUPABASE_ANON_KEY=your-anon-key

# Which sign-in buttons the app shows, comma-separated. Unset means `google`
# alone, which is what shipped before this existed. A provider listed here MUST
# also be enabled in the Supabase dashboard (Authentication → Providers) with
# its own client id and secret, or its button bounces back with "Unsupported
# provider". See SUPABASE-SYNC.md for what each one costs to set up.
#   VITE_AUTH_PROVIDERS=google,facebook,apple
VITE_AUTH_PROVIDERS=google
