{
  "name": "bito-chess",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-engine.mjs && vite",
    "build": "node scripts/copy-engine.mjs && tsc && tsc -p tsconfig.worker.json && vite build",
    "selftest": "node --experimental-strip-types --import ./scripts/register-ts.mjs scripts/run-selftests.ts",
    "probe-sync-limit": "node scripts/probe-sync-limit.mjs",
    "preview": "vite preview",
    "generate-icons": "node scripts/generate-icons.mjs",
    "build-openings": "node scripts/build-openings.mjs",
    "build-explorer-stats": "node scripts/build-explorer-stats.mjs",
    "build-starter-packs": "node scripts/build-starter-packs.mjs",
    "build-study-index": "node scripts/build-study-index.mjs",
    "build-traps": "node scripts/build-traps.mjs",
    "build-traps-lichess": "node scripts/build-traps-from-lichess.mjs",
    "build-puzzle-openings": "node scripts/build-puzzle-openings.mjs"
  },
  "dependencies": {
    "@bity/oauth2-auth-code-pkce": "^2.13.0",
    "@supabase/supabase-js": "^2.112.2",
    "chess.js": "^1.3.0",
    "chessground": "^9.1.0",
    "stockfish": "^18.0.7",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vite": "^5.4.0"
  }
}
