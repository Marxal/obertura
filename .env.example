# Copy this file to `.env` and fill in the real values. `.env` is gitignored —
# never commit it. Vite only exposes variables prefixed with VITE_ to the app.
#
# Every variable here must ALSO be set in the Cloudflare Pages project
# (Settings → Environment variables), because Vite inlines them at build time —
# the deployed build reads them from the build environment, not from this file.
#
# With none of them set, the app still builds and boots; each feature simply
# reports itself as not configured and hides its own UI.
#
# The two Supabase values come from the Supabase dashboard:
#   Project Settings → API (or Data API / API Keys on newer dashboards)

# Project URL, e.g. https://abcdefghijklmno.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The public "anon" / publishable key — safe to ship in the bundle, protected by
# row-level security. NOT the service_role key, which must never go in here.
VITE_SUPABASE_ANON_KEY=your-anon-key

# The Lemon Squeezy checkout link for the one-off "full access" purchase.
# Lemon Squeezy dashboard → Products → your product → the variant's "Share" /
# buy link. Just the bare URL: src/lemonsqueezy.ts appends `embed=1` and the
# buyer's Supabase user id itself.
#
# Public by design — it's a store page anyone can open, so having Vite inline it
# into the bundle is fine. The webhook's three secrets (see LEMONSQUEEZY-SETUP.md)
# are the sensitive ones and live only in the Worker, never as VITE_ variables.
#
# Unset, the app still builds and boots; the buy buttons just don't appear.
VITE_LEMONSQUEEZY_CHECKOUT_URL=https://your-store.lemonsqueezy.com/buy/your-variant-id
