{
  // Presence of this file stops Cloudflare's build system from auto-detecting
  // Vite and trying to wire up its Cloudflare Vite plugin integration (which
  // requires Vite 6+ — we're not upgrading just to satisfy that autoconfig).
  //
  // This is a WORKER, not a Pages project — deploys run `npx wrangler deploy`.
  // That is why the webhook lives in worker/index.ts and routes itself, rather
  // than in a `functions/` folder: file-based routing is a Pages feature and
  // does nothing here. See the comment at the top of worker/index.ts.
  "name": "bitochess",
  "compatibility_date": "2026-08-08",
  // @supabase/supabase-js pulls in a few Node built-ins on its way to the
  // bundler; this flag lets Workers provide them instead of the build failing
  // to resolve them.
  "compatibility_flags": ["nodejs_compat"],
  // The server code. Everything it doesn't answer is handed back to the static
  // assets below.
  "main": "./worker/index.ts",
  // Points at the DEPLOY_TARGET=cloudflare build output root: dist/index.html
  // is the landing page, dist/app/ is the trainer (see vite.config.ts).
  "assets": {
    "directory": "./dist",
    // Lets worker/index.ts serve static files itself via env.ASSETS.fetch().
    "binding": "ASSETS",
    // Default behaviour is assets-first: a request only reaches the Worker if
    // no static file matches. Scoping run_worker_first to /api/* inverts that
    // for the webhook alone, so a POST to /api/... is guaranteed to reach the
    // Worker, while every page, script and image is served exactly as it was
    // before any server code existed.
    "run_worker_first": ["/api/*"]
  }
}
